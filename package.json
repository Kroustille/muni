{
  "name": "muni",
  "version": "0.1.0",
  "description": "Offline-first life companion PWA — typed lists (shopping, books, movies, recipes) with hexagonal Next.js architecture",
  "private": true,
  "packageManager": "yarn@1.22.22",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "build:migrations": "tsc -p db/tsconfig.json",
    "migrate:up": "yarn run build:migrations && node dist/db/migrate.js up",
    "migrate:down": "yarn run build:migrations && node dist/db/migrate.js down",
    "db:codegen": "yarn run migrate:up && kysely-codegen --dialect postgres --exclude-pattern 'kysely_*' --out-file src/adapters/postgres/db-types.ts && prettier --write src/adapters/postgres/db-types.ts",
    "db:codegen:check": "yarn run db:codegen && git diff --exit-code src/adapters/postgres/db-types.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "muni": {
    "catalog": {
      "books": {
        "provider": "open-library",
        "apiBase": "https://openlibrary.org",
        "npmPackage": null,
        "note": "Server-side fetch only (X2); no Open Library npm dependency"
      },
      "barcodeScanner": {
        "wasm": "@undecaf/zbar-wasm@0.11.0"
      },
      "movies": {
        "provider": "wikidata",
        "apiBase": "https://www.wikidata.org/w/api.php",
        "npmPackage": null,
        "note": "Server-side fetch only (X2); keyless Wikidata API"
      }
    }
  },
  "dependencies": {
    "@serwist/next": "^9.5.13",
    "@undecaf/zbar-wasm": "0.11.0",
    "idb": "^8.0.4",
    "jose": "^6.2.12",
    "kysely": "^0.29.6",
    "next": "^15.5.28",
    "nodemailer": "^10.1.1",
    "openid-client": "^6.8.8",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.28",
    "fake-indexeddb": "^6.2.5",
    "kysely-codegen": "^0.20.0",
    "postcss": "^8.5.30",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
